# 복사해서 .env 로 쓰기 (cp .env.example .env) - .env 는 절대 커밋하지 않기

# AI (packages/ai) - 작업공간 키일 때만 ANTHROPIC_WORKSPACE_ID 채우기
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5
# 키가 없을 때 /estimate · /record 를 넘길 배포본 API (예: https://hanatour-290-app.vercel.app/api). 키가 있으면 안 씀
AI_UPSTREAM=

# API 서버 (apps/api) - LOG_LEVEL=debug 면 응답 JSON 전체를 로그로
PORT=8787
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
